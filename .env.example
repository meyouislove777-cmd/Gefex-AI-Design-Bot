# Gefex — AI Design Bot
# انسخ هذا الملف باسم .env وأملأ البيانات

# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID
CLIENT_ID=your_client_id_here

# Guild ID (اختياري - لمزامنة سريعة في سيرفر واحد)
GUILD_ID=

# OpenAI API Key
OPENAI_API_KEY=your_openai_key_here

# الحد اليومي للصور (default: 12)
DAILY_LIMIT=12
